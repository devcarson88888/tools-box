{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "tools-box",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
